{
  "rules": {
    ".read": "auth != null",

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
      }
    },

    "tasks": {
      "$taskId": {
        ".read": "auth != null && (data.child('assignedTo').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || data.child('assignedTo').val() == auth.uid)"
      }
    },

    "transactionsByUser": {
      "$loginKey": {
        "$transactionId": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('loginKey').val() == $loginKey || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
        }
      }
    }
  }
}